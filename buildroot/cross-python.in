#!/bin/sh
# Configure PL/Python using the host interpreter and the target's sysconfig.
export PYTHONPATH=@STAGING_DIR@/usr/lib/python@PYTHON_VERSION@
for configuration in "$PYTHONPATH"/_sysconfigdata_*.py; do
    _PYTHON_SYSCONFIGDATA_NAME=${configuration##*/}
    export _PYTHON_SYSCONFIGDATA_NAME=${_PYTHON_SYSCONFIGDATA_NAME%.py}
done
if [ "$1" = -c ]; then
    exec @HOST_DIR@/bin/python3 -c '
import sys, sysconfig
configuration = sysconfig.get_config_vars()
for key in ("LIBPL", "INCLUDEPY", "LIBDIR"):
    configuration[key] = "@STAGING_DIR@" + configuration[key]
exec(sys.argv[1])
' "$2"
fi
exec @HOST_DIR@/bin/python3 "$@"
