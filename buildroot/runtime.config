# Use the same Linux headers and retain glibc's older-kernel compatibility.
BR2_TOOLCHAIN_BUILDROOT=y
BR2_KERNEL_HEADERS_5_15=y
BR2_PACKAGE_GLIBC_KERNEL_COMPAT=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_ENABLE_LOCALE=y
BR2_OPTIMIZE_2=y
BR2_SHARED_STATIC_LIBS=y
# BR2_HIDE_SECONDARY_TARGET_OPTIONS is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_ROOTFS_TAR is not set
BR2_INIT_NONE=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_POSTGRESQL_BINARIES_PATH)/busybox.config"
