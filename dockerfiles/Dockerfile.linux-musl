# alpine:3.19.0 (multi-platform index)
FROM alpine:3.19.0@sha256:51b67269f354137895d43f3b3d810bfacd3945438e94dc5ac55fdac340352f48

ARG POSTGRESQL_VERSION
ARG TARGET_CFLAGS="-O2"
ENV CFLAGS="$TARGET_CFLAGS"
ENV CXXFLAGS="$TARGET_CFLAGS"

RUN echo "POSTGRESQL_VERSION=$POSTGRESQL_VERSION"
RUN apk update
RUN apk add --no-cache \
      ca-certificates \
      bash \
      bison \
      clang16 \
      dpkg \
      dpkg-dev \
      e2fsprogs-dev \
      flex \
      g++ \
      gcc \
      gettext-dev \
      git \
      icu \
      icu-data-full \
      icu-dev \
      krb5-dev \
      libc-dev \
      libxml2-dev \
      libxslt-dev \
      linux-headers \
      llvm16-dev \
      lz4 \
      lz4-dev \
      make \
      musl-dev \
      openssl-dev \
      ossp-uuid-dev \
      patchelf \
      perl \
      perl-dev \
      perl-ipc-run \
      perl-utils \
      python3 \
      python3-dev \
      readline-dev \
      util-linux-dev \
      zlib-dev \
      zstd-dev

COPY scripts/fetch-source.sh /usr/local/bin/fetch-source
RUN update-ca-certificates && \
    fetch-source "$POSTGRESQL_VERSION" /usr/src/postgresql

WORKDIR /usr/src/postgresql

COPY scripts/relocate-plpython.py /usr/local/bin/
RUN python3 /usr/local/bin/relocate-plpython.py /usr/src/postgresql

ENV CLANG=clang-16
ENV LLVM_CONFIG="/usr/lib/llvm16/bin/llvm-config"

RUN major_version=$(echo "$POSTGRESQL_VERSION" | awk -F. '{print $1}') && \
    ./configure \
      --prefix /opt/postgresql \
      --enable-integer-datetimes \
      --enable-option-checking=fatal \
      --enable-tap-tests \
      $([ $major_version -le 16 ] && echo "--enable-thread-safety") \
      --with-gssapi \
      $([ $major_version -ge 14 ] && echo "--with-icu" || echo "--without-icu") \
      --without-ldap \
      --with-libxml \
      --with-libxslt \
      $([ $major_version -ge 16 ] && echo "--with-llvm") \
      $([ $major_version -ge 14 ] && echo "--with-lz4") \
      --with-openssl \
      --with-pgport=5432 \
      $([ $major_version -ge 15 ] && echo "--with-python") \
      --with-readline \
      --with-uuid=ossp \
      $([ $major_version -ge 16 ] && echo "--with-zstd") && \
    make $([ $major_version -ge 15 ] && echo "world-bin") && \
    make $([ $major_version -ge 15 ] && echo "install-world-bin" || echo "install") && \
    make -C contrib install

COPY scripts/bundle-icu-data.sh /usr/local/bin/
RUN bash /usr/local/bin/bundle-icu-data.sh /opt/postgresql

# Audit executables, extension modules, and their transitive dependencies.
COPY scripts/bundle-runtime.py scripts/collect-notices.py /usr/local/bin/
RUN python3 /usr/local/bin/bundle-runtime.py /opt/postgresql && \
    python3 /usr/local/bin/collect-notices.py /opt/postgresql

RUN cp /usr/src/postgresql/COPYRIGHT /usr/src/postgresql/source-input.json /opt/postgresql

# Create user and group for running tests
RUN addgroup -S -g 1000 postgresql && \
    adduser -D -S -G postgresql -u 1000 -s /bin/ash postgresql && \
    mkdir -p /opt/test && \
    chown postgresql:postgresql /opt/test

USER postgresql
